{
  "name": "saikyo-cw",
  "version": "0.21.4",
  "description": "All-in-one Chatwork enhancement Chrome extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build",
    "build": "npm run lint && tsc --noEmit && BUILD_TARGET=content vite build && BUILD_TARGET=background vite build && BUILD_TARGET=options vite build",
    "package": "npm run build && cd dist && zip -r ../saikyo-cw.zip .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
